# Copy this file to .env and fill in the values. Never commit .env.

PORT=5000
# Comma-separated list of sites allowed to call the API
CLIENT_ORIGIN=http://localhost:5173

# ---- Gemini (LLM) ----
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ---- Upstash Vector ----
# Create an index at https://console.upstash.com/vector
# Pick a built-in embedding model (e.g. BAAI/bge-base-en-v1.5) so Upstash makes the embeddings
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# ---- Email (contact form) ----
# Gmail: turn on 2-Step Verification, then create an App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Where contact form messages are delivered
CONTACT_TO=ebadhafeez0504@gmail.com
